{
  "name": "polish-design-tokens",
  "version": "1.7.1",
  "description": "Design token superpower tool: extract · critique · apply · publish via npm",
  "type": "module",
  "bin": {
    "polish": "bin/polish.mjs"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./scan": "./src/scan.js",
    "./cross": "./src/cross.js",
    "./parse": "./src/parse.js",
    "./measure": "./src/measure.js",
    "./diff": "./src/diff.js",
    "./confirm": "./src/confirm.js",
    "./apply": "./src/apply.js",
    "./plan": "./src/plan.js",
    "./wizard": "./src/wizard.js",
    "./report": "./src/report.js",
    "./mcp": "./src/mcp-server.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "banner.jpg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/polish.mjs",
